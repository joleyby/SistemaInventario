<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:PresentacionWpf.ViewModels">

    <!-- ===== CATEGORÍAS ===== -->
    <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="260" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Ver papelera" IsChecked="{Binding MostrarEliminados}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="2*"/>
                        <DataGridTextColumn Header="Modificada" Binding="{Binding FechaModificacion, StringFormat=dd/MM/yyyy HH:mm}" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Datos de la categoría" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="Nombre"/>
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Descripción"/>
                    <TextBox Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Fotos (0 a 5 · .jpg/.png · máx. 2 MB)"/>
                    <ListBox ItemsSource="{Binding Fotos}" SelectedItem="{Binding FotoSeleccionada}"
                             DisplayMemberPath="NombreArchivo" Height="90" Margin="0,2,0,4"/>
                    <WrapPanel>
                        <Button Content="Agregar foto..." Command="{Binding AgregarFotosCommand}" Padding="8,2" Margin="0,0,6,0"/>
                        <Button Content="Quitar foto" Command="{Binding QuitarFotoCommand}" Padding="8,2"/>
                        <Button Content="Abrir foto" Command="{Binding AbrirFotoCommand}" Padding="8,2" Margin="6,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ErrorGeneral}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Restaurar" Command="{Binding RestaurarCommand}" Padding="10,3" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===== SUPLIDORES ===== -->
    <DataTemplate DataType="{x:Type vm:SuplidoresViewModel}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="260" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Ver papelera" IsChecked="{Binding MostrarEliminados}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Empresa" Binding="{Binding NombreEmpresa}" Width="*"/>
                        <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="*"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="Auto"/>
                        <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Datos del suplidor" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="Empresa"/>
                    <TextBox Text="{Binding NombreEmpresa, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Contacto"/>
                    <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Teléfono (809/829/849-XXX-XXXX)"/>
                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Correo"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Sitio web (opcional)"/>
                    <TextBox Text="{Binding SitioWeb, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="{Binding ErrorGeneral}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Restaurar" Command="{Binding RestaurarCommand}" Padding="10,3" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===== PRODUCTOS ===== -->
    <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Width="180" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Categoría:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox Width="150" ItemsSource="{Binding CategoriasFiltro}" DisplayMemberPath="Nombre"
                              SelectedValuePath="Id" SelectedValue="{Binding FiltroCategoriaId}"/>
                    <TextBlock Text="Suplidor:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox Width="150" ItemsSource="{Binding SuplidoresFiltro}" DisplayMemberPath="NombreEmpresa"
                              SelectedValuePath="Id" SelectedValue="{Binding FiltroSuplidorId}"/>
                    <TextBlock Text="Precio:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox Width="70" Text="{Binding PrecioMinimo, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="a" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <TextBox Width="70" Text="{Binding PrecioMaximo, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Ver papelera" IsChecked="{Binding MostrarEliminados}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Seleccionado}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="Auto"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="*"/>
                        <DataGridTextColumn Header="Suplidor" Binding="{Binding NombreSuplidor}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Datos del producto" FontWeight="Bold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock Text="Nombre"/>
                    <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Precio unitario"/>
                    <TextBox Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Categoría (activa)"/>
                    <ComboBox ItemsSource="{Binding CategoriasActivas}" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                              SelectedValue="{Binding CategoriaId, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="Suplidor (activo)"/>
                    <ComboBox ItemsSource="{Binding SuplidoresActivos}" DisplayMemberPath="NombreEmpresa" SelectedValuePath="Id"
                              SelectedValue="{Binding SuplidorId, ValidatesOnNotifyDataErrors=True}" Margin="0,2,0,8"/>
                    <TextBlock Text="{Binding ErrorGeneral}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}" Padding="10,3" Margin="0,0,6,6"/>
                        <Button Content="Restaurar" Command="{Binding RestaurarCommand}" Padding="10,3" Margin="0,0,0,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===== REPORTES (consultas LINQ de la capa de negocio) ===== -->
    <DataTemplate DataType="{x:Type vm:ReportesViewModel}">
        <DockPanel Margin="10">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding ValorTotalTexto}"/>
                <Button Content="Actualizar" Command="{Binding ActualizarCommand}" Margin="16,0,0,0" Padding="10,2"/>
            </WrapPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="Productos por categoría" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding ProductosPorCategoria}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                            <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadProductos}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="Top 5 suplidores" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding Top5Suplidores}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Suplidor" Binding="{Binding Suplidor}" Width="*"/>
                            <DataGridTextColumn Header="Productos" Binding="{Binding CantidadProductos}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="Precio promedio por categoría" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding PromedioPrecios}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Categoria}" Width="*"/>
                            <DataGridTextColumn Header="Promedio" Binding="{Binding PrecioPromedio, StringFormat=C2}" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>



